# ---------------------------------------------------------------------------
# Heat Priority Engine — environment template.
# Copy to `.env.local` and fill in. NEVER commit a filled-in file.
# Everything without the NEXT_PUBLIC_ prefix is server-only and is never
# bundled into client JavaScript.
# ---------------------------------------------------------------------------

# --- Server-only: FortyGuard credentials and transport -----------------------
# Issued after hackathon registration. Leave empty to run in no-key mode:
# the app stays fully usable and every FortyGuard gate reports BLOCKED_LIVE.
FORTYGUARD_API_KEY=
FORTYGUARD_API_BASE_URL=https://api.fortyguard.com
FORTYGUARD_AUTH_HEADER=api-key

# --- Server-only: request shaping -------------------------------------------
# Conservative default. Documented plan ceilings are 10 mi² (Basic/Startup) and
# 50 mi² (Premium); 9 keeps every tile inside the smallest documented ceiling.
FORTYGUARD_MAX_TILE_SQ_MI=9
FORTYGUARD_MAX_CONCURRENCY=2
FORTYGUARD_POLL_TIMEOUT_SECONDS=600

# Master switch for outbound live calls. 0 = no network request is ever made.
# This gates the CAPTURE endpoint only. Nothing reachable from a page render or
# from the public planning endpoint can call FortyGuard at all.
RUN_LIVE_FORTYGUARD=0

# There is no capture endpoint and no operator token. Capture is a local CLI
# (npm run fortyguard:capture) that refuses to run in a hosted environment, so a
# deployment cannot spend a credit however it is configured.

# --- Server-only: mode selection --------------------------------------------
# Where the thermal layer comes from. There is deliberately no `live` value.
#   cached_real — serve the committed immutable snapshot. No network access.
#                 Fails loudly if no snapshot is committed for the request.
#   demo        — the labelled synthetic fixture.
#   auto        — cached_real when a snapshot exists, otherwise demo.
DATA_MODE=auto
# auto | HEAT_EXPOSURE_AND_ANOMALY | EXPOSURE_ONLY | ANOMALY_ONLY | NO_GO_THERMAL_PRODUCT
PRODUCT_MODE=auto

# --- Public (safe to expose in the browser bundle) ---------------------------
# Optional MapLibre style URL. Empty = the built-in, key-free raster style
# defined in lib/geo/map-style.ts (OpenStreetMap raster tiles, attributed).
NEXT_PUBLIC_MAP_STYLE_URL=

# --- Release controls (used by scripts, not by the app) ----------------------
DEPLOY_PREVIEW=0
PUBLISH_SUBMISSION=0
