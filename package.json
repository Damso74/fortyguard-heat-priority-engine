{
  "name": "heat-priority-engine",
  "version": "1.0.0",
  "private": true,
  "description": "Transit Heat Inspection Prioritization \u2014 FortyGuard Hackathon '26",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "predev": "node scripts/sync-maplibre-worker.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/sync-maplibre-worker.mjs",
    "build": "next build",
    "postbuild": "node scripts/check-build-assets.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "data:fetch": "python scripts/fetch/fetch_arcgis.py",
    "data:gtfs": "python scripts/fetch/fetch_gtfs.py",
    "data:check": "python scripts/fetch/fetch_arcgis.py --check && python scripts/fetch/fetch_gtfs.py --check",
    "data:check-distributed": "node scripts/check-distributed-data.mjs",
    "data:baseline": "python scripts/spike/analyze_shadefirst.py",
    "data:generate": "python scripts/generate/build_analysis_dataset.py",
    "fortyguard:probe": "python scripts/fortyguard/run_fortyguard_probe.py",
    "fortyguard:import-pilot": "tsx scripts/fortyguard/import-phoenix-pilot.mjs",
    "verify": "node scripts/verify.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "data:rebuild": "node scripts/verify-rebuild.mjs",
    "data:rebuild-distributed": "node scripts/verify-rebuild.mjs --gtfs-only",
    "check:snapshots": "tsx scripts/check-snapshot-store.mjs",
    "check:build-assets": "node scripts/check-build-assets.mjs",
    "data:unredistribute": "node scripts/unredistribute-raw-layers.mjs",
    "fortyguard:capture": "tsx scripts/fortyguard/capture.mjs",
    "submission:captions": "node scripts/submission/build-captions.mjs",
    "submission:record": "node scripts/submission/record-demo.mjs",
    "submission:assemble": "node scripts/submission/assemble-video.mjs"
  },
  "dependencies": {
    "@turf/boolean-point-in-polygon": "7.4.0",
    "@turf/helpers": "7.4.0",
    "maplibre-gl": "6.1.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "10.8.0",
    "globals": "17.9.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.7",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0",
    "vitest": "4.1.10"
  }
}
